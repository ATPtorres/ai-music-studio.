# El editor de letras, la guía local y los motores musicales no requieren variables.
# Asistencia Gemini opcional: configurar SOLO en Netlify Functions, nunca en VITE_.
# Valores vacíos: no son credenciales y la IA seguirá desactivada.
GEMINI_API_KEY=
GEMINI_MODEL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Netlify proporciona URL y DEPLOY_PRIME_URL para comprobar el origen del sitio.
