# El editor de letras, la guía local y los motores musicales no requieren variables.
# Asistencia Gemini opcional: configurar SOLO en Netlify Functions, nunca en VITE_.
# Valores vacíos: no son credenciales y la IA seguirá desactivada.
GEMINI_API_KEY=
GEMINI_MODEL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Netlify proporciona URL y DEPLOY_PRIME_URL para comprobar el origen del sitio.

# --- Agente de composición (opcional; proxy local de Vite) ---
# Proveedor compatible con OpenAI. La clave se queda en el servidor: nunca uses VITE_.
# Sin LLM_MODEL, el agente queda desactivado y el resto del estudio funciona igual.
# Ejemplos de LLM_BASE_URL:
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://127.0.0.1:11434/v1   (sin clave, solo en local)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
